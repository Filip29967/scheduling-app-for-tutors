<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" styleClass="root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pl.kalendarz.kalendarz.StudentListController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Button fx:id="backButton" mnemonicParsing="false" onAction="#goBack" text="powrót" />
            <Button fx:id="addStudentButton" mnemonicParsing="false" onAction="#openAddStudentView" text="Dodaj Ucznia" />
            <Button fx:id="editButton" mnemonicParsing="false" onAction="#goEdit" text="Edytuj" />
            <Button fx:id="selectAllButton" mnemonicParsing="false" onAction="#selectAllStudents" text="Zaznacz wszystkich" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button fx:id="deleteStudentButton" mnemonicParsing="false" onAction="#deleteSelectedStudents" text="Usuń wybranych" />
         </children>
         <padding>
            <Insets left="20.0" right="20.0" top="10.0" />
         </padding>
      </HBox>
      <TableView fx:id="tableView" prefHeight="450.0" prefWidth="900.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="select" prefWidth="70.0" text="Wybierz" />
            <TableColumn fx:id="id" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="firstName" prefWidth="150.0" text="Imie" />
            <TableColumn fx:id="lastName" prefWidth="200.0" text="Nazwisko" />
            <TableColumn fx:id="dayOfWeek" prefWidth="150.0" text="Dzień" />
            <TableColumn fx:id="time" prefWidth="150.0" text="Godzina" />
        </columns>
         <VBox.margin>
            <Insets left="20.0" right="20.0" />
         </VBox.margin>
      </TableView>
      <Label fx:id="statusLabel" styleClass="status-label" />
   </children>
   <padding>
      <Insets bottom="20.0" />
   </padding>
</VBox>
