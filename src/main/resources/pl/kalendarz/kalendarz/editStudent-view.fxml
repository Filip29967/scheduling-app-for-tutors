<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.ColumnConstraints?>

<VBox alignment="TOP_CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pl.kalendarz.kalendarz.EditController" styleClass="root">
    <children>
        <HBox alignment="CENTER_LEFT">
            <children>
                <Button fx:id="backButton" mnemonicParsing="false" onAction="#goBack" text="powrót" />
            </children>
            <padding>
                <Insets left="20.0" top="20.0" />
            </padding>
        </HBox>
        <Label text="Edytuj Ucznia" styleClass="label" style="-fx-font-size: 20px;" />
        <GridPane alignment="CENTER" hgap="20.0" vgap="15.0">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" minWidth="100.0" />
                <ColumnConstraints halignment="LEFT" minWidth="200.0" />
            </columnConstraints>
            <children>
                <Label text="Imie:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="firstNameTextField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Nazwisko:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="lastNameTextField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Dzień tygodnia:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <ComboBox fx:id="dayComboBox" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label text="Godzina:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <HBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                <children>
                    <ComboBox fx:id="hourComboBox" prefWidth="80.0" />
                    <Label text=":" style="-fx-padding: 5 0 0 0;"/>
                    <ComboBox fx:id="minuteComboBox" prefWidth="80.0" />
                </children>
            </HBox>
            </children>
        </GridPane>
        <Button fx:id="saveButton" mnemonicParsing="false" onAction="#saveStudent" prefWidth="150.0" text="Zapisz" />
        <Label fx:id="statusLabel" styleClass="status-label" />
    </children>
</VBox>
